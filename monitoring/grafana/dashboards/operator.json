      "id": 3,
      "title": "Ingress to SQL and searchable index · 5 min",
      "datasource": {
        "type": "prometheus",
        "uid": "visions-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
