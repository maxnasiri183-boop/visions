        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": ""
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Routine Load offset lag",
      "datasource": {
        "type": "prometheus",
        "uid": "visions-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "visions_operator_routine_load_lag",
          "legendFormat": "Kafka records",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
