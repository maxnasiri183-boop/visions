          "legendFormat": "{{source}} · intentionally sampled out",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
