{
  "title": "Operator feed and search",
  "uid": "visions-operator",
  "tags": [
    "visions",
    "operator"
  ],
  "schemaVersion": 41,
  "version": 3,
  "timezone": "utc",
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "id": 1,
      "title": "Frames per second",
      "datasource": {
        "type": "prometheus",
        "uid": "visions-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(visions_operator_observed_input_fps and on() (up{job=\"operator\"} == 1))",
          "legendFormat": "All · observed input",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "B",
          "expr": "sum(visions_operator_processed_fps and on() (up{job=\"operator\"} == 1))",
          "legendFormat": "All · processed",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "C",
          "expr": "sum(visions_operator_target_fps and on() (up{job=\"operator\"} == 1))",
          "legendFormat": "All · playout target",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "D",
          "expr": "visions_operator_observed_input_fps and on() (up{job=\"operator\"} == 1)",
          "legendFormat": "{{source}} · observed input",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "E",
          "expr": "visions_operator_processed_fps and on() (up{job=\"operator\"} == 1)",
          "legendFormat": "{{source}} · processed",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "F",
          "expr": "visions_operator_target_fps and on() (up{job=\"operator\"} == 1)",
          "legendFormat": "{{source}} · playout target",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "fps",
          "noValue": "No measurements"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Observed input counts pre-inference decoded frame receipts, including retry reads, over 5 s. Processed counts first durable frame commits over 5 s. Target uses source FPS × the current occurrence feed speed. All sums are per scrape."
    },
    {
      "type": "timeseries",
      "id": 17,
      "title": "Face observations per second",
      "datasource": {
        "type": "prometheus",
        "uid": "visions-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(visions_operator_published_observations_total[1m]) and on() (visions_operator_publication_observer_available == 1))",
          "legendFormat": "All · published",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(visions_operator_sql_visible_observations_total[1m]) and on() (visions_operator_sql_observer_available == 1))",
          "legendFormat": "All · first SQL-visible",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "C",
          "expr": "rate(visions_operator_published_observations_total[1m]) and on() (visions_operator_publication_observer_available == 1)",
          "legendFormat": "{{source}} · published",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "D",
          "expr": "rate(visions_operator_sql_visible_observations_total[1m]) and on() (visions_operator_sql_observer_available == 1)",
          "legendFormat": "{{source}} · first SQL-visible",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: obs/s",
          "noValue": "No measurements"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Trailing 1 min. Published counts physical Kafka messages including replay. SQL-visible counts each detection ID on its first successful SQL visibility check. Zero requires an available observer; missing samples leave a gap."
    },
    {
      "type": "stat",
      "id": 28,
      "title": "New observations in selected time range",
      "datasource": {
        "type": "prometheus",
        "uid": "visions-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((last_over_time(visions_operator_sql_visible_observations_total[$__range]) - min_over_time(visions_operator_sql_visible_observations_total[$__range])) and (count_over_time(visions_operator_sql_visible_observations_total[$__range]) >= 2) and (resets(visions_operator_sql_visible_observations_total[$__range]) == 0))",
          "legendFormat": "All · new SQL-visible",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          },
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "(last_over_time(visions_operator_sql_visible_observations_total[$__range]) - min_over_time(visions_operator_sql_visible_observations_total[$__range])) and (count_over_time(visions_operator_sql_visible_observations_total[$__range]) >= 2) and (resets(visions_operator_sql_visible_observations_total[$__range]) == 0)",
          "legendFormat": "{{source}} · new SQL-visible",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No measurements",
          "color": {
            "mode": "fixed",
            "fixedColor": "light-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "description": "Exact increase between the first and last actual counter scrapes inside the time selection. The active run's per-source counters only increase. Unobserved fractions of scrape intervals are excluded. A source needs at least two samples and a continuous counter in the selected range."
    },
    {
      "type": "stat",
      "id": 29,
      "title": "Gallery identities and SQL observations",
      "datasource": {
        "type": "prometheus",
        "uid": "visions-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "visions_operator_gallery_people",
          "legendFormat": "Gallery identities",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          },
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "visions_operator_retained_sql_rows",
          "legendFormat": "Retained SQL observations",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          },
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "sum(visions_operator_sql_visible_observations_total)",
          "legendFormat": "Cumulative SQL observations",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No measurements",
          "color": {
            "mode": "fixed",
            "fixedColor": "light-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "description": "Gallery identities count distinct people with an eligible reference in the published version. Retained SQL observations query the current primary-key table across all runs. Cumulative distinct observations are first SQL sightings for the active run, including expired evidence. Retained SQL population is independently sampled at most once per five minutes. See Measurement availability and Time since latest checkpoint for count status and sample age."
    },
    {
      "type": "stat",
      "id": 30,
      "title": "Measurement availability",
      "datasource": {
        "type": "prometheus",
        "uid": "visions-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(up{job=\"operator\"}) + 2) or vector(-1)",
          "legendFormat": "Exporter",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          },
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "((sum(visions_operator_observed_input_fps) > bool 0) and on() (up{job=\"operator\"} == 1)) or vector(-1)",
          "legendFormat": "Input activity",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          },
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "(max(visions_operator_publication_observer_available)+2) or vector(-1)",
          "legendFormat": "Kafka observer",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          },
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "expr": "(max(visions_operator_sql_observer_available)+2) or vector(-1)",
          "legendFormat": "SQL observer",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          },
          "instant": true,
          "range": false
        },
        {
          "refId": "E",
          "expr": "(max(visions_operator_retained_sql_sample_available)+2) or vector(-1)",
          "legendFormat": "Retained SQL sample",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No measurements",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Missing telemetry",
                  "color": "gray",
                  "index": 0
                },
                "0": {
                  "text": "No traffic",
                  "color": "blue",
                  "index": 1
                },
                "1": {
                  "text": "Receiving frames",
                  "color": "green",
                  "index": 2
                },
                "2": {
                  "text": "Unavailable",
                  "color": "red",
                  "index": 3
                },
                "3": {
                  "text": "Available",
                  "color": "green",
                  "index": 4
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "description": "Prometheus availability is independent of the exporter. No traffic means there are no input receipts in the recent 5 s. Missing telemetry, a failed scrape, and an unavailable Kafka or SQL observer are different states."
    },
    {
      "type": "timeseries",
      "id": 31,
      "title": "Ingestion to SQL visibility p95 · 5 min",
      "datasource": {
        "type": "prometheus",
        "uid": "visions-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "visions_operator_stage_seconds{stage=\"sql_visibility\",quantile=\"p95\"}",
          "legendFormat": "All sources",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "B",
          "expr": "visions_operator_source_sql_p95_seconds",
          "legendFormat": "{{source}}",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No measurements"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Wall-clock frame_ingested_at to first successful SQL poll for unique detections. Nearest-rank p95. All uses the pooled samples; a source with no recent SQL observations has no percentile."
    },
    {
      "type": "timeseries",
      "id": 18,
      "title": "Completed frame accounting",
      "datasource": {
        "type": "prometheus",
