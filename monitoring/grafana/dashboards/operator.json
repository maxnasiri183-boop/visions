{
  "title": "Operator feed and search",
  "uid": "visions-operator",
  "tags": [
    "visions",
    "operator"
  ],
  "schemaVersion": 41,
  "version": 1,
  "timezone": "utc",
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "id": 15,
      "title": "Source online and telemetry freshness",
      "datasource": {
        "type": "prometheus",
        "uid": "visions-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "h": 8,
        "w": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "visions_operator_source_online",
          "legendFormat": "{{source}} \u00b7 online",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "B",
          "expr": "1 - visions_operator_stale",
          "legendFormat": "{{source}} \u00b7 recent processed frames",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "C",
          "expr": "up{job=\"operator\"}",
          "legendFormat": "exporter available",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "1 indicates healthy or fresh. Zero indicates an outage or stale samples. An absent series means the instrument has no data."
    },
    {
      "type": "timeseries",
      "id": 1,
      "title": "Playout target and measured throughput \u00b7 5 s",
      "datasource": {
        "type": "prometheus",
        "uid": "visions-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "h": 8,
        "w": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "visions_operator_target_fps",
          "legendFormat": "{{source}} \u00b7 playout target",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "B",
          "expr": "visions_operator_decoded_fps",
          "legendFormat": "{{source}} \u00b7 decoded",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "C",
