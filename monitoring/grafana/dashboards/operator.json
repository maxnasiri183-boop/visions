    },
    {
      "type": "timeseries",
      "id": 16,
      "title": "Time since latest checkpoint",
      "datasource": {
        "type": "prometheus",
        "uid": "visions-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - visions_operator_latest_decoded_at",
          "legendFormat": "{{source}} · decoded",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "B",
          "expr": "time() - visions_operator_latest_processed_at",
          "legendFormat": "{{source}} · processed",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "C",
          "expr": "time()-visions_operator_latest_searchable_at",
