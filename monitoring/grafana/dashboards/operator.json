      },
      "description": "Unmapped messages can belong to other isolated runs with their own occurrence database. Missed offsets indicate that Kafka retention advanced past the durable checkpoint. A nonzero missed count marks incomplete historical coverage."
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Detection and recognition stages · 5 min",
      "datasource": {
        "type": "prometheus",
        "uid": "visions-metrics"
      },
      "gridPos": {
        "x": 12,
