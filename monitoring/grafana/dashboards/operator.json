        {
          "refId": "D",
          "expr": "visions_operator_processed_fps",
          "legendFormat": "{{source}} \u00b7 processed",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "fps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "The catalog specifies the file rate. Decoded FPS measures distinct frame admissions. Inference FPS counts actual forwards."
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Ingress to SQL and searchable index \u00b7 5 min",
