        }
      },
      "description": ""
    },
    {
      "type": "timeseries",
      "id": 32,
      "title": "Publication observer continuity",
      "datasource": {
        "type": "prometheus",
        "uid": "visions-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "visions_operator_publication_observer_lag",
          "legendFormat": "Reader offset lag",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "B",
          "expr": "visions_operator_publication_missed_offsets",
          "legendFormat": "Missed offsets",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        },
        {
          "refId": "C",
          "expr": "visions_operator_publication_unmapped_records",
          "legendFormat": "Unmapped records",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No measurements"
        },
