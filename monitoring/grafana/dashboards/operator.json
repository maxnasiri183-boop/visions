          }
        },
        {
          "refId": "D",
          "expr": "visions_operator_retained_sql_sample_age_seconds",
          "legendFormat": "Retained SQL row sample age",
          "datasource": {
            "type": "prometheus",
            "uid": "visions-metrics"
          }
        }
      ],
      "fieldConfig": {
