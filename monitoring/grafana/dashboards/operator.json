          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Wall time from decoded observation to independently observed visibility. Rolling 5-minute p50/p95. Sample counts appear in the next row."
